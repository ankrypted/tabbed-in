{
  "name": "tabbed-in",
  "version": "0.2.0",
  "private": true,
  "description": "Lock yourself to one tab until the timer ends.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bundle:windows": "wxt zip && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer.ps1",
    "bundle:unix": "wxt zip && node scripts/make-unix-installer.mjs",
    "release:extension": "wxt zip && node scripts/make-extension-tarball.mjs",
    "test:installer:unix": "npm run bundle:unix && bash installer/unix/test-install.sh",
    "test:installer": "npm run bundle:windows && powershell -NoProfile -ExecutionPolicy Bypass -File installer/windows/test-install.ps1",
    "test:installer:open": "npm run bundle:windows && powershell -NoProfile -ExecutionPolicy Bypass -File installer/windows/test-open-page.ps1",
    "compile": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "wxt build && node e2e/run.mjs",
    "test:e2e:only": "node e2e/run.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
