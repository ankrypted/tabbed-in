{
  "manifest_version": 3,
  "name": "Tabbed In",
  "version": "1.0",
  "description": "Set a countdown on any tab. When time is up, the tab closes.",
  "permissions": ["tabs", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Tabbed In" }
}
